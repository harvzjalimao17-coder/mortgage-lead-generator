        "jsCode": "const items = $input.all();\nconst results = [];\n\nconst timelineScores = {\n  \"immediately\": 50,\n  \"1–3 months\": 35,\n  \"3–6 months\": 20,\n  \"6+ months\": 10,\n  \"just exploring\": 0\n};\n\nconst serviceScores = {\n  \"pre-approval\": 30,\n  \"purchase\": 25,\n  \"investment property\": 25,\n  \"refinance\": 15,\n  \"other\": 5\n};\n\nfunction normalize(value) {\n  return (value ?? \"\").toString().trim().toLowerCase();\n}\n\nfunction isNonBlank(value) {\n  return value !== null && value !== undefined && value.toString().trim().length > 0;\n}\n\nfor (const item of items) {\n  const data = item.json;\n\n  const timelineScore = timelineScores[normalize(data.desired_timeline)] ?? 0;\n  const serviceScore = serviceScores[normalize(data.service)] ?? 0;\n\n  let completenessScore = 0;\n  if (isNonBlank(data.estimated_property_value)) completenessScore += 5;\n  if (isNonBlank(data.down_payment_range)) completenessScore += 5;\n  if (isNonBlank(data.employment_status)) completenessScore += 5;\n  if (isNonBlank(data.first_time_buyer)) completenessScore += 5;\n\n  let leadScore = timelineScore + serviceScore + completenessScore;\n  if (leadScore > 100) leadScore = 100;\n\n  let leadPriority;\n  if (leadScore >= 65) {\n    leadPriority = \"HOT\";\n  } else if (leadScore >= 35) {\n    leadPriority = \"WARM\";\n  } else {\n    leadPriority = \"COLD\";\n  }\n\n  results.push({\n    json: {\n      ...data,\n      lead_score: leadScore,\n      lead_priority: leadPriority\n    }\n  });\n}\n\nreturn results;"
      },
