    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const originalLead = $('Prepare Lead').first().json;\nconst existingLead = $json;\n\nreturn {\n  json: {\n    success: false,\n    status: \"DUPLICATE\",\n    message: \"A lead with this email already exists.\",\n\n    lead_id: existingLead.lead_id,\n    existing_lead_id: existingLead.lead_id,\n\n    name: originalLead.name,\n    email: originalLead.email,\n    address: originalLead.address,\n    service: originalLead.service,\n\n    estimated_property_value:\n      originalLead.estimated_property_value,\n\n    down_payment_range:\n      originalLead.down_payment_range,\n\n    employment_status:\n      originalLead.employment_status,\n\n    first_time_buyer:\n      originalLead.first_time_buyer,\n\n    desired_timeline:\n      originalLead.desired_timeline,\n\n    contact_phone:\n      originalLead.contact_phone,\n\n    preferred_contact_method:\n      originalLead.preferred_contact_method,\n\n    best_time_to_contact:\n      originalLead.best_time_to_contact,\n\n    note: originalLead.note,\n\n    source: originalLead.source\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
