    {
      "parameters": {
        "jsCode": "const lead = $json.body || $json;\n\nconst requiredFields = [\n  \"name\",\n  \"email\",\n  \"address\",\n  \"service\"\n];\n\nconst missingFields = requiredFields.filter(field => {\n  return (\n    !lead[field] ||\n    String(lead[field]).trim() === \"\"\n  );\n});\n\nconst emailValid =\n  /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(\n    String(lead.email || \"\").trim()\n  );\n\nconst isValid =\n  missingFields.length === 0 &&\n  emailValid;\n\nreturn {\n  json: {\n    ...lead,\n\n    validation: {\n      valid: isValid,\n      missing_fields: missingFields,\n      invalid_email: !emailValid\n    }\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        -80
      ],
