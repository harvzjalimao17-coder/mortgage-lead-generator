    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $json;\n\nconst leadId = `LEAD-${Date.now()}`;\n\nconst propertyValue =\n  String(lead.estimated_property_value || \"\").trim();\n\nreturn {\n  json: {\n    lead_id: leadId,\n\n    name: String(lead.name || \"\").trim(),\n\n    email: String(lead.email || \"\")\n      .trim()\n      .toLowerCase(),\n\n    address: String(lead.address || \"\").trim(),\n\n    service: String(lead.service || \"\").trim(),\n\n    estimated_property_value:\n      propertyValue === \"\" ? null : Number(propertyValue),\n\n    down_payment_range:\n      String(lead.down_payment_range || \"\").trim() || null,\n\n    employment_status:\n      String(lead.employment_status || \"\").trim() || null,\n\n    first_time_buyer:\n      String(lead.first_time_buyer || \"\").trim() || null,\n\n    desired_timeline:\n      String(lead.desired_timeline || \"\").trim() || null,\n\n    contact_phone:\n      String(lead.contact_phone || \"\").trim() || null,\n\n    preferred_contact_method:\n      String(lead.preferred_contact_method || \"\").trim() || null,\n\n    best_time_to_contact:\n      String(lead.best_time_to_contact || \"\").trim() || null,\n\n    note: String(lead.note || \"\").trim(),\n\n    status: \"NEW\",\n\n    source: \"Mortgage Website\"\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -192,
        -80
      ],
